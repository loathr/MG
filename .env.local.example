# Required: Anthropic API key for content generation
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional: Image search APIs
NEXT_PUBLIC_UNSPLASH_KEY=
NEXT_PUBLIC_PEXELS_KEY=

# Optional: Sanity CMS. With no project id the marketing site runs on its
# built-in copy and /cms shows a "not configured" notice. Set the project id
# (from sanity.io/manage) to enable editing; dataset defaults to "production".
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
