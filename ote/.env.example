# ── OTE environment ────────────────────────────────────────────────────────
# Copy to `.env` (git-ignored) and fill in. Also set NEXT_PUBLIC_MEDIA_BASE in
# Vercel → Settings → Environment Variables for the deployed site.

# Public base URL for media. Client-visible (that's fine — it's just a URL).
#   Option A (start): your R2 public bucket URL, e.g. https://pub-abc123.r2.dev
#   Option B (later): https://cdn.otes.me
# Leave blank to render generative placeholders everywhere.
NEXT_PUBLIC_MEDIA_BASE=

# ── Used ONLY by scripts/optimize.mjs — never shipped to the browser ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=otes-media
